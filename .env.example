# Copie para `.env` (que o .gitignore já ignora) e preencha. NUNCA commite o `.env`.
# Os scripts em scripts/ leem este arquivo da raiz do repositório; uma variável já
# definida no ambiente sempre ganha dele.

# Endereço público do seu site (sem barra no fim) e a senha da área de administração.
APP_SITE_URL=https://seu-site.exemplo.com
APP_SENHA=troque-esta-senha
# (ADMIN_PASSWORD também é aceita no lugar de APP_SENHA)

# Provedor de vídeo (Bunny Stream): a Stream API Key DA LIBRARY, não a Account API Key.
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_PULLZONE=vz-xxxxxxxx-xxx.b-cdn.net

# Opcional: catálogo local a usar no lugar de exemplo/catalogo.json (relativo à raiz).
# APP_CATALOGO=catalogo.json

# Opcional: transcrição (scripts/legendas-assembly.mjs) e textos por IA (sinopses.mjs, series.mjs).
# ASSEMBLYAI_API_KEY=
# ANTHROPIC_API_KEY=
