# Copie para `.env` (que o .gitignore já ignora) e preencha. NUNCA commite o `.env`.
# Os scripts em scripts/ leem este arquivo da raiz do repositório; uma variável já
# definida no ambiente sempre ganha dele.

# Endereço público do seu site (sem barra no fim) e a senha da área de administração.
APP_SITE_URL=https://seu-site.exemplo.com
APP_SENHA=troque-esta-senha
# (ADMIN_PASSWORD também é aceita no lugar de APP_SENHA)

# Provedor de vídeo: o escolhido em config/site.json (`video.provedor`). Cada adaptador (core/worker/_lib/provedores/)
# lê as variáveis que a config aponta com {"$env": "NOME"}; sem apontamento, vale o nome padrão abaixo.
# Bunny Stream: a Stream API Key DA LIBRARY, não a Account API Key.
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_PULLZONE=vz-xxxxxxxx-xxx.b-cdn.net
# BUNNY_TOKEN_KEY=   (chave de Token Authentication; modo privado, M5)

# Cloudflare Stream (video.provedor = "cloudflare-stream"). Token com permissão "Stream: Edit".
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_TOKEN=
# CLOUDFLARE_STREAM_SUBDOMINIO=customer-xxxx
# Opcionais (modo privado e webhook):
# CLOUDFLARE_STREAM_KEY_ID=
# CLOUDFLARE_STREAM_KEY_JWK=
# CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# HLS genérico (video.provedor = "hls-generico"): endereço base dos vídeos (https, sem porta). Não é segredo;
# também pode ir em config/site.json (video.hlsGenerico.baseUrl). Outros hosts: video.hlsGenerico.hostsPermitidos.
# HLS_BASE_URL=https://videos.exemplo.com/acervo

# Opcional: catálogo local a usar no lugar de exemplo/catalogo.json (relativo à raiz).
# APP_CATALOGO=catalogo.json

# Opcional: transcrição (scripts/legendas-assembly.mjs) e textos por IA (sinopses.mjs, series.mjs).
# ASSEMBLYAI_API_KEY=
# ANTHROPIC_API_KEY=
