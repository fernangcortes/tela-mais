# Copie para `.env` (que o .gitignore já ignora) e preencha. NUNCA commite o `.env`.
# Os scripts em scripts/ leem este arquivo da raiz do repositório; uma variável já
# definida no ambiente sempre ganha dele.

# Endereço público do seu site (sem barra no fim) e a senha da área de administração.
APP_SITE_URL=https://seu-site.exemplo.com
APP_SENHA=troque-esta-senha
# (ADMIN_PASSWORD também é aceita no lugar de APP_SENHA)

# Provedor de vídeo: o escolhido em config/site.json (`video.provedor`). Cada adaptador (core/worker/_lib/provedores/)
# lê as variáveis que a config aponta com {"$env": "NOME"}; sem apontamento, vale o nome padrão abaixo.
# Bunny Stream: a Stream API Key DA LIBRARY, não a Account API Key.
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_PULLZONE=vz-xxxxxxxx-xxx.b-cdn.net
# BUNNY_TOKEN_KEY=   (Security key da pull zone, Token Authentication; modo privado)
# BUNNY_EMBED_KEY=   (opcional: chave do Embed View Token da library; sem ela o embed some no modo privado)

# Cloudflare Stream (video.provedor = "cloudflare-stream"). Token com permissão "Stream: Edit".
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_TOKEN=
# CLOUDFLARE_STREAM_SUBDOMINIO=customer-xxxx
# Opcionais (modo privado e webhook):
# CLOUDFLARE_STREAM_KEY_ID=
# CLOUDFLARE_STREAM_KEY_JWK=
# CLOUDFLARE_STREAM_KEY_PEM=   (alternativa ao JWK: o `pem` da resposta de POST /stream/keys)
# CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# HLS genérico (video.provedor = "hls-generico"): endereço base dos vídeos (https, sem porta). Não é segredo;
# também pode ir em config/site.json (video.hlsGenerico.baseUrl). Outros hosts: video.hlsGenerico.hostsPermitidos.
# HLS_BASE_URL=https://videos.exemplo.com/acervo

# Contas de espectador (modos `cadastro` e `privado`, M5). Vão ao Worker por `wrangler secret put` (os secrets) e
# `vars` (as variáveis públicas); aqui só para `npm run dev` (copie para .dev.vars).
# TURNSTILE_SECRET=         (secret do Turnstile: o cadastro aberto só abre com ele)
# TURNSTILE_SITE_KEY=       (chave PÚBLICA do Turnstile, a que o navegador usa)
# RESEND_API_KEY=           (se acesso.email.adaptador = "resend")
# EMAIL_REMETENTE=Nome <aviso@seu-dominio.com>
# SESSION_SECRET=           (>= 32 caracteres, diferente da senha do admin)

# Opcional: catálogo local a usar no lugar de exemplo/catalogo.json (relativo à raiz).
# APP_CATALOGO=catalogo.json

# Opcional: IA de conteúdo (M9; paga por uso e desligada por padrão: docs/ia.md). Só a(s) chave(s) do provedor que você escolheu em
# config/site.json (ia.textos, ia.transcricao). Guarde com: node scripts/setup.mjs segredo NOME
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ASSEMBLYAI_API_KEY=
# Workers AI fora do Worker (scripts e GitHub): CLOUDFLARE_API_TOKEN (permissão Workers AI) e CLOUDFLARE_ACCOUNT_ID.
# Botão "Gerar no GitHub" do /admin (segredo do WORKER, não do .env): token fino do GitHub, só este repositório, Actions: Read and write.
# GITHUB_DISPATCH_TOKEN=
