{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.dev.vars)",
      "Read(./.dev.vars.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./segredos/**)",
      "Read(./secrets/**)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Edit(./.dev.vars)",
      "Edit(./segredos/**)",
      "Edit(./secrets/**)",
      "Write(./.env)",
      "Write(./.env.local)",
      "Write(./.env.production)",
      "Write(./.dev.vars)",
      "Write(./segredos/**)",
      "Write(./secrets/**)",
      "Bash(printenv:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/bloquear-segredos.mjs\""
          }
        ]
      }
    ]
  }
}
