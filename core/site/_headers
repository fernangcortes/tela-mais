# Cabeçalhos de segurança dos arquivos estáticos (Static Assets).
# A mesma política sai do Worker (core/worker/_lib/seguranca.js);
# tests/worker-seguranca.test.js confere que as duas dizem o mesmo.
/*
  content-security-policy: default-src 'self'; script-src 'self' 'sha256-pC8lL4UeLJne9z7wZYaoWQLHpQbyzO358yhEUQELSYQ=' https://assets.mediadelivery.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.b-cdn.net; media-src 'self' blob: https://*.b-cdn.net; connect-src 'self' https://*.b-cdn.net https://video.bunnycdn.com; frame-src https://player.mediadelivery.net https://iframe.mediadelivery.net; font-src 'self' data:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
  x-content-type-options: nosniff
  x-frame-options: SAMEORIGIN
  referrer-policy: no-referrer
  permissions-policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  cross-origin-opener-policy: same-origin
  strict-transport-security: max-age=31536000
